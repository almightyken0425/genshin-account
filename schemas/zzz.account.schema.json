{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOYO ZZZ video observations v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "game",
    "source",
    "characters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "game": {
      "const": "zzz"
    },
    "source": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "durationSeconds",
        "capturedAt"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level",
          "mindscape",
          "stats",
          "skills",
          "wEngine",
          "driveDiscs",
          "evidence",
          "uncertainties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 60
          },
          "mindscape": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 6
          },
          "stats": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          },
          "skills": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 20
                },
                {
                  "type": "string",
                  "pattern": "^[A-F]$"
                }
              ]
            }
          },
          "wEngine": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rarity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 60
              },
              "refinement": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            },
            "additionalProperties": true
          },
          "driveDiscs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "timestampSec",
                "framePath",
                "sha256"
              ],
              "properties": {
                "timestampSec": {
                  "type": "number",
                  "minimum": 0
                },
                "framePath": {
                  "type": "string",
                  "pattern": "^evidence/zzz/(?!.*\\.\\.)[a-zA-Z0-9_./-]+\\.(png|jpe?g)$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "page": {
                  "type": "string"
                },
                "timestampToleranceSec": {
                  "type": "number",
                  "minimum": 0
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "portraitPath": {
            "type": "string",
            "pattern": "^evidence/zzz/(?!.*\\.\\.)[a-zA-Z0-9_./-]+\\.(png|jpe?g)$"
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "portraitSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "element": {
            "type": [
              "string",
              "null"
            ]
          },
          "specialty": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
